# Copy to .env.local and replace every placeholder. Never commit real values.
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters; do not reuse the recovery code.
SESSION_SECRET=
# Initial password only: 12-128 characters. Saved password hashes take precedence.
ADMIN_PASSWORD=
# At least 32 random characters, at most 256.
RECOVERY_CODE=
